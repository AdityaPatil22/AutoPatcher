# ──────────────────────────────────────────────
# AutoPatcher — Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM Provider ──────────────────────────────
# Providers: "gemini" | "openai" | "nvidia" | "local-ollama"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API key for your chosen provider (Gemini, OpenAI, or NVIDIA)
# Not needed for local-ollama
API_KEY=your-api-key

# Daily LLM request limit per user (default: 5)
# LLM_DAILY_LIMIT=5

# ── GitHub OAuth ──────────────────────────────
# Create an OAuth App: https://github.com/settings/developers
# Set callback URL to: <your-backend-url>/api/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Fernet key for encrypting GitHub tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE-ME-generate-a-fernet-key
JWT_SECRET=CHANGE-ME-generate-a-jwt-secret

# URL to redirect to after OAuth callback
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL Database (Neon Console) ────────
# Neon Console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── ChromaDB Vector Database ─────────────────
# Mode: "local" (disk), "cloud" (Chroma Cloud), or "server" (self-hosted HTTP)
CHROMA_MODE=cloud

# Chroma Cloud settings (https://www.trychroma.com/)
CHROMA_API_KEY=your-chroma-cloud-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=your-chroma-database

# Self-hosted ChromaDB (only used when CHROMA_MODE=server)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Local ChromaDB storage (only used when CHROMA_MODE=local)
# CHROMA_PERSIST_DIR=./.chroma_index

# ── Security ──────────────────────────────────
# Comma-separated CORS origins (* for all)
ALLOWED_ORIGINS=*

# Rate limits (requests per minute per IP)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LLM=10

# ── Other ─────────────────────────────────────
# Max context files sent to LLM per request
# MAX_CONTEXT_FILES=3

# Temp directory for cloned repos (default: system temp)
# CLONE_DIR=/tmp/autopatch_clones
