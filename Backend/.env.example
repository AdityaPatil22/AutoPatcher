# Provider: "local" or "gemini" (selectable from the UI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Gemini API key (pre-configured, not editable from UI)
# GEMINI_API_KEY=your-gemini-key-here

# Local model server URL (Ollama / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Security: comma-separated allowed CORS origins
ALLOWED_ORIGINS=*

# Rate limits (requests per minute per IP)
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LLM=10

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE-ME-generate-a-fernet-key
FRONTEND_URL=https://autopatch-ai-production.up.railway.app/

# PostgreSQL connection string
DATABASE_URL=postgresql://localhost/autopatch

# Temp directory for cloned repos (default: system temp)
# CLONE_DIR=/tmp/autopatch_clones

