# Provider: "local" or "gemini" (selectable from the UI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Gemini API key (pre-configured, not editable from UI)
# GEMINI_API_KEY=your-gemini-key-here

# Local model server URL (Ollama / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Security: comma-separated allowed CORS origins
ALLOWED_ORIGINS=*

# Rate limits (requests per minute per IP)
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LLM=10

