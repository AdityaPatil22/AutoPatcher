# Provider: "local" or "cloud" (selectable from the UI)
LLM_PROVIDER=local

# Cloud API keys (set one to enable cloud provider)
# OPENAI_API_KEY=sk-your-openai-key-here
# GEMINI_API_KEY=your-gemini-key-here

# Model name (leave empty for provider default)
# Local defaults: llama3:8b | Cloud defaults: gpt-4o-mini (OpenAI) or gemini-1.5-flash (Gemini)
LLM_MODEL=llama3:8b

# Local model server URL (Ollama / LM Studio / llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# ChromaDB persist directory (defaults to .chroma_index in project root)
# CHROMA_PERSIST_DIR=./.chroma_index
