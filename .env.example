# Choose provider: "openai", "gemini", or "local"
# LLM_PROVIDER=openai

# OpenAI
# OPENAI_API_KEY=api-key
# LLM_MODEL=gpt-4o-mini

# Google Gemini (alternative)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=api-key
# LLM_MODEL=gemini-1.5-flash

# Local model via Ollama / LM Studio / llama.cpp (alternative)
LLM_PROVIDER=local
LLM_MODEL=deepseek-coder:6.7b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Path to the sample codebase (defaults to ./sample_repo)
SAMPLE_REPO_PATH=/Users/adpatil/Documents/Projects/2025/SweetSpot/Sweetspot-Frontend

# Max files to include as context for multi-file patches (default: 3)
MAX_CONTEXT_FILES=3

# Search mode: "keyword" (original), "semantic" (embeddings only), "hybrid" (both)
SEARCH_MODE=hybrid

# ChromaDB persist directory (defaults to .chroma_index in project root)
# CHROMA_PERSIST_DIR=./.chroma_index